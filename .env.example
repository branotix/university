# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.

PORT=8080
# Origin allowed to call the API (CORS). Use * for local dev, your real domain in production.
FRONTEND_ORIGIN=*
# The backend's own public URL. bKash redirects the user's browser here after payment.
# For local testing, bKash's sandbox can't reach "localhost" directly — use a tunnel like
# ngrok (e.g. https://abcd1234.ngrok-free.app) and put that URL here while testing bKash.
PUBLIC_BASE_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=change_me
DB_NAME=varsity_db

# Generate a long random string for production, e.g: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# bKash Tokenized Checkout - Sandbox (safe to use for testing only)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
# After testing, switch to your real merchant credentials + BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta/tokenized

# Email verification (sent via Gmail SMTP). Gmail requires a 16-character
# "App Password" — NOT your normal Gmail password. Create one at:
# Google Account -> Security -> 2-Step Verification (must be ON) -> App passwords
# If you leave SMTP_USER blank, verification codes are just printed to the
# server console instead of emailed (fine for local testing, NOT for real users).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# TURN server (see scripts/setup-coturn.sh for how to set one up).
# Leave blank to run STUN-only (fine for testing, but ~20-30% of real-world
# calls on mobile data / restrictive networks will fail to connect without it).
TURN_DOMAIN=
TURN_SECRET=
